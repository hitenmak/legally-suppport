<!-- Style ------------------------------------------------------------>
<%- contentFor('style'); %>

    <!-- Content ------------------------------------------------------------>
    <%- contentFor('content'); %>

        <div class="content-wrapper">
            <!-- Page Header -->
            <section class="content-header">
                <div class="container-fluid">
                    <div class="row mb-2">
                        <div class="col-sm-6">
                            <h1>Dashboard</h1>
                        </div>
                    </div>
                </div>
            </section>
            <!-- / Page Header -->


            <section class="row ">
                <div class=" col-12 col-sm-12 col-md-6 m-auto ">
                    <!-- <div class="row"> -->
                    <!-- <div class="column"> -->
                    <div class="card card-widget widget-user w-100 w-md-50 w-lg-25 m-auto">
                        <div class="widget-user-header" style="background-color:#FFBD69;">
                            <h3 class="widget-user-username text-dark font-weight-bold">
                                <%= admin?.name %>
                            </h3>
                            <h5 class="widget-user-desc text-dark">
                                <%= admin?.email %>
                            </h5>
                        </div>

                        <!-- <div class="widget-user-image">
    <img class="img-circle elevation-2" src="/img/user1.jpg" alt="User Avatar">
  </div> -->

                        <div class="card-footer">
                            <div class="row">
                                <div class="col-sm-4 border-right">
                                    <div class="description-block">
                                        <h2 class="description-header text-lg">
                                            <%= admin?.tickets ?? 0 %>
                                        </h2>
                                        <span class="description-text text-capitalize">Tickets Accepted</span>
                                    </div>
                                </div>
                                <div class="col-sm-4 border-right">
                                    <div class="description-block">
                                        <h2 class="description-header text-lg">
                                            <%= admin?.avgAcceptTime ? `${admin?.avgAcceptTime}` : '-' %>
                                        </h2>
                                        <span class="description-text text-capitalize ">Avg. Acceptance Time</span>
                                    </div>
                                </div>
                                <div class="col-sm-4">
                                    <div class="description-block">
                                        <h2 class="description-header text-lg">
                                            <%= admin?.avgResTime ? `${admin?.avgResTime}`: '-' %>
                                        </h2>
                                        <span class="description-text text-capitalize">Avg. Response Time</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>


                <!-- </div> -->
                <!-- </div> -->
            </section>
            <% if ((otherAdmins || [])?.length) { %>
                <hr color="white" width="80%">
                <p class="text-center text-lg"><b>Other Admins & Agents</b></p>
                <section class="content">
                    <div class="container-fluid">
                        <div class="row">
                            <% otherAdmins.forEach(admin=> { %>
                                <div class="col-sm-12 col-md-6 col-lg-4 mb-4">
                                    <div class="card card-widget widget-user h-100">
                                        <div class="widget-user-header" style="background-color:#FFBD69;">
                                            <h3 class="widget-user-username text-dark font-weight-bold">
                                                <%= admin?.name %>
                                            </h3>
                                            <h5 class="widget-user-desc text-dark">
                                                <%= admin?.email %>
                                            </h5>
                                        </div>

                                        <div class="card-footer">
                                            <div class="row">
                                                <div class="col-sm-4 border-right">
                                                    <div class="description-block">
                                                        <h2 class="description-header text-lg">
                                                            <%= admin?.tickets ?? 0 %>
                                                        </h2>
                                                        <span class="description-text text-capitalize">Tickets
                                                            Accepted</span>
                                                    </div>
                                                </div>
                                                <div class="col-sm-4 border-right">
                                                    <div class="description-block">
                                                        <h2 class="description-header text-lg">
                                                            <%= admin?.avgAcceptTime ? `${admin?.avgAcceptTime}` : '-'
                                                                %>
                                                        </h2>
                                                        <span class="description-text text-capitalize">Avg. Acceptance
                                                            Time</span>
                                                    </div>
                                                </div>
                                                <div class="col-sm-4">
                                                    <div class="description-block">
                                                        <h2 class="description-header text-lg">
                                                            <%= admin?.avgResTime ? `${admin?.avgResTime}` : '-' %>
                                                        </h2>
                                                        <span class="description-text text-capitalize">Avg. Response
                                                            Time</span>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <% }) %>
                        </div>
                    </div>
                </section>
                <% } %>
        </div>
        <!-- Script ------------------------------------------------------------>
        <%- contentFor('script'); %>