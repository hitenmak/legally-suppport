<% ConfigLabels={ 'title' : { 's' : 'SubCategory' , 'p' : 'SubCategories' }, 'updateUrl' :
    _.getFullUrl("subcategory/update"), 'deleteUrl' : _.getFullUrl('subcategory/delete/' + subCategory._id) }; %>

    <%- contentFor('style'); %>
        <style>
            .post {
                border: none;
            }

            .username {
                font-size: 50px;
            }
        </style>

        <%- contentFor('content'); %>

            <div class="content-wrapper">

                <!-- Page Header -->
                <section class="content-header">
                    <div class="container-fluid">
                        <div class="row mb-2">
                            <div class="col-sm-6">
                                <h1>
                                    <%= ConfigLabels.title.s %>
                                </h1>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- Main Content -->
                <section class="content">
                    <div class="container-fluid">

                        <!-- ================= SUBCATEGORY DETAILS ================= -->
                        <div class="card">
                            <!-- Actions -->
                            <div class="m-1">
                                <button class="btn bg-gradient-secondary mr-2" onclick="history.back()">
                                    <i class="bi bi-arrow-left-short"></i>
                                </button>

                                <!-- <a class="btn bg-gradient-danger mr-2" href="< %= ConfigLabels.deleteUrl %>">
                                    <i class="bi bi-trash"></i>
                                </a> -->
                            </div>
                            <div class="card-body py-2">

                                <div class="row ">

                                    <!-- Label -->
                                    <div class="col-md-6 mb-1">
                                        <label class="small mb-1">
                                            <!-- Subcategory -->
                                            Name</label>
                                        <div class="h5 mb-0">
                                            <%= subCategory?.label %>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <!-- ================= UPDATE FORM (ALWAYS OPEN) ================= -->

                        <div class="card mt-1">
                            <!-- <div class="card-header bg-warning"> -->
                            <!-- <h6 class="mb-0">Update SubCategory</h6> -->
                            <!-- </div> -->

                            <div class="card-body">
                                <form method="POST" action="<%= ConfigLabels.updateUrl %>">

                                    <!-- Hidden ID -->
                                    <input type="hidden" name="id" value="<%= subCategory?._id %>">

                                    <!-- SubCategory Name -->
                                    <div class="form-group">
                                        <label>Name</label>
                                        <input type="text" name="label" class="form-control"
                                            value="<%= subCategory?.label %>" required>
                                    </div>

                                    <!-- Parent Category Dropdown -->
                                    <div class="form-group">
                                        <label>Select Category</label>
                                        <select name="categoryId" class="form-control" required>
                                            <option value="">Select Category</option>

                                            <% categoryList.forEach(function(category) { %>
                                                <option value="<%= category?._id %>"
                                                    <%=category._id.toString()===subCategory.categoryId.toString()
                                                    ? 'selected' : '' %>>
                                                    <%= category.label %>
                                                </option>
                                                <% }); %>

                                        </select>
                                    </div>

                                    <button type="submit" class="btn bg-gradient-warning">
                                        Update
                                    </button>

                                    <button type="button" class="btn btn-default" onclick="history.back()">
                                        Cancel
                                    </button>
                                </form>
                            </div>
                        </div>

                    </div>
                </section>

            </div>

            <%- contentFor('script'); %>