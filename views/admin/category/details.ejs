<% ConfigLabels={ 'title' : { 's' : 'Category' , 'p' : 'Categories' }, 'updateUrl' :
    _.getFullUrl("category/update"), 'deleteUrl' : _.getFullUrl('category/delete/' + _id) }; %>

    <%- contentFor('style'); %>

        <%- contentFor('content'); %>

            <div class="content-wrapper">

                <!-- Page Header -->
                <section class="content-header">
                    <div class="container-fluid">
                        <div class="row mb-2">
                            <div class="col-sm-6">
                                <h1>
                                    <%= ConfigLabels.title.s %>
                                </h1>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- Main Content -->
                <section class="content">
                    <div class="container-fluid">

                        <!-- Category Details -->
                        <div class="card">
                            <div class="card-body">

                                <div class="post py-4">
                                    <div class="user-block">
                                        <h2 class="username">
                                            <%= label %>
                                        </h2>
                                        <span class="description">
                                            Created on - <%= createdAt %>
                                        </span>
                                    </div>
                                </div>

                                <!-- Actions -->
                                <div class="">
                                    <button class="btn bg-gradient-secondary mr-2" onclick="history.back()">
                                        <i class="bi bi-arrow-left-short"></i>
                                    </button>

                                    <a class="btn bg-gradient-danger mr-2" href="<%= ConfigLabels.deleteUrl %>">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                </div>

                            </div>
                        </div>

                        <!-- ================= UPDATE FORM  ================= -->

                        <div class="card mt-3">
                            <div class="card-header bg-warning">
                                <h6 class="mb-0">Update Category</h6>
                            </div>

                            <div class="card-body">
                                <form method="POST" action="<%= ConfigLabels.updateUrl %>">

                                    <!-- Hidden ID -->
                                    <input type="hidden" name="id" value="<%= _id %>">

                                    <div class="form-group">
                                        <label>Name</label>
                                        <input type="text" name="label" class="form-control" value="<%= label %>"
                                            required>
                                    </div>

                                    <button type="submit" class="btn bg-gradient-warning">
                                        Update
                                    </button>

                                    <button type="button" class="btn btn-default" onclick="history.back()">
                                        Cancel
                                    </button>

                                </form>
                            </div>
                        </div>

                    </div>
                </section>

            </div>
            <%- contentFor('script') %>
                <script>
                    $(document).ready(function () {

                        // Show Update Form
                        $('#showUpdateForm').click(function () {
                            $('#updateFormCard').slideDown();
                            $('html, body').animate({
                                scrollTop: $("#updateFormCard").offset().top - 100
                            }, 400);
                        });

                        // Hide Update Form
                        $('#cancelUpdate').click(function () {
                            $('#updateFormCard').slideUp();
                        });

                    });
                </script>