<% ConfigLabels={ title: { cat: 'Category' , cats: 'Categories' }, addUrl: _.getFullUrl('category/create') }; %>

    <% const constant={ FILTER: 'currentFiltersCategories' }; %>

        <!-- ================= STYLE ================= -->
        <%- contentFor('style') %>
            <style>
                h4 {
                    margin: 0;
                }
            </style>

            <!-- ================= CONTENT ================= -->
            <%- contentFor('content') %>

                <div class="content-wrapper">

                    <!-- ================= PAGE HEADER ================= -->
                    <section class="content-header">
                        <div class="container-fluid">
                            <div class="row mb-2">

                                <!-- Left Title -->
                                <div class="col-sm-4">
                                    <h1>
                                        <%= ConfigLabels.title.cats %>
                                            <span class="badge badge-secondary ml-2 _pagerTotalRecords d-none"></span>
                                    </h1>
                                </div>

                                <!-- Right Add Button -->
                                <div class="col-sm-8 text-right">
                                    <button class="btn bg-gradient-success btn-sm" data-toggle="modal"
                                        data-target="#addCategoryModal">
                                        <i class="bi bi-plus-circle"></i> Add Category
                                    </button>
                                </div>

                            </div>
                        </div>
                    </section>

                    <!-- ================= MAIN CONTENT ================= -->
                    <section class="content">
                        <div class="container-fluid">

                            <!-- Table Placeholder -->
                            <ANY id="tw"></ANY>

                        </div>
                    </section>

                </div>


                <!-- ================= ADD CATEGORY MODAL ================= -->
                <div class="modal fade" id="addCategoryModal">
                    <div class="modal-dialog">
                        <div class="modal-content">

                            <div class="modal-header bg-success">
                                <h4 class="modal-title">Add Category</h4>
                                <button type="button" class="close" data-dismiss="modal">&times;</button>
                            </div>

                            <form method="POST" action="<%= ConfigLabels.addUrl %>">

                                <div class="modal-body">
                                    <div class="form-group">
                                        <label>Name</label>
                                        <input type="text" name="label" id="category-label" class="form-control"
                                            required>
                                        <input type="hidden" name="name" id="category-name" class="form-control"
                                            required>
                                    </div>
                                </div>

                                <div class="modal-footer">
                                    <button type="submit" class="btn bg-gradient-success">
                                        Save
                                    </button>
                                    <button type="button" class="btn btn-default" data-dismiss="modal">
                                        Cancel
                                    </button>
                                </div>

                            </form>

                        </div>
                    </div>
                </div>


