                <!-- ================= SCRIPT ================= -->
                <%- contentFor('script') %>

                    <script>

                        tableLayout = {
                            label: { label: 'Name', displayType: 'text', isSearchable: 1, isSortable: 1 }
                        }

                        recordUrls = {
                            listing: 'category/list'
                        };

                        updateFilter = (isOldGet = false) => {
                            // let currentFilters = localStorage.getItem(constant.FILTER);
                            let currentFilters = localStorage.getItem('currentFiltersCategories');
                            if (currentFilters) currentFilters = JSON.parse(currentFilters) || {};
                            else currentFilters = {};

                            getPage(1);
                        }

                        init(() => {
                            initTable(true, false);
                            updateFilter(true);
                        });

                        $(document).on('click', '.goToPage', function () {
                            let currentFilters = localStorage.getItem('currentFiltersCategories');
                            if (currentFilters) currentFilters = JSON.parse(currentFilters) || {};

                            getPage($(this).attr('data-pg-no'));
                        });

                        const labelField = document.getElementById("category-label");
                        const nameField = document.getElementById("category-name");

                        labelField.addEventListener("input", () => {
                            let value = labelField.value
                                .trim()                         // remove starting & ending spaces
                                .toUpperCase()                  // convert to uppercase
                                .replace(/&/g, " AND ")         // replace & with AND
                                .replace(/\//g, " OR ")            // replace / with OR
                                // .replace(/[(),]/g, " ")         // remove special separators
                                .replace(/[^A-Z0-9]+/g, "-")    // replace anything non-alphanumeric with -
                                .replace(/-+/g, "-")            // remove duplicate dashes
                                .replace(/^-|-$/g, "")         // remove starting/ending dash
                            nameField.value = value;
                        });
                    </script>